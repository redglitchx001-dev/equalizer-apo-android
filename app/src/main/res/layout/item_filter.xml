<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/apo_card_bg"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/check_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/apo_accent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/text_filter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter 1: Peaking EQ"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_filter_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fc: 1000 Hz | Q: 1.41"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_gain_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="@color/apo_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="240"
            android:progress="120"
            android:progressTint="@color/apo_accent"
            android:thumbTint="@color/apo_accent" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
