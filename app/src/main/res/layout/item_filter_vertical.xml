<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#212529"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:strokeColor="#3A3E45"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="6dp">

        <!-- Top Header: Checkbox + Band Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/check_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00E676"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/text_band_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="b1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filter Type Selector Button -->
        <Button
            android:id="@+id/btn_filter_type"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:padding="0dp"
            android:text="PK"
            android:textColor="#00E676"
            android:textSize="10sp"
            app:strokeColor="#00E676"
            app:strokeWidth="1dp" />

        <!-- Frequency Box (Hz) -->
        <EditText
            android:id="@+id/edit_freq"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="#15171A"
            android:gravity="center"
            android:hint="1000"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hz"
            android:textColor="#888888"
            android:textSize="9sp" />

        <!-- Gain dB Value Readout -->
        <TextView
            android:id="@+id/text_gain_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0.0 dB"
            android:textColor="#00B0FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Vertical Gain Slider -->
        <SeekBar
            android:id="@+id/seek_gain_vert"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="4dp"
            android:max="600"
            android:progress="300"
            android:progressTint="#00B0FF"
            android:rotation="270"
            android:thumbTint="#00E676" />

        <!-- Quality Factor (Q) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q"
            android:textColor="#888888"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/edit_q"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="#15171A"
            android:gravity="center"
            android:hint="1.41"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="10sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
